# auto: demo without FAL_KEY, live with it. demo: always free demo. live: requires key.
AI_MODE=auto
# The only credential; server-only. Never prefix with NEXT_PUBLIC_.
FAL_KEY=
# All text tasks go through https://fal.run/openrouter/router.
FAL_TEXT_MODEL=google/gemini-2.5-flash
# Supported reference-edit endpoints: this model or fal-ai/flux-pro/kontext/max.
FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext
# Paid attempts per Node process per hour (failures count); 0 disables that kind.
AI_TEXT_REQUESTS_PER_HOUR=40
AI_IMAGES_PER_HOUR=12
