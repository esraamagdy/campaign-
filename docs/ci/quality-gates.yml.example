# DORMANT TEMPLATE: outside .github/workflows; no CI is enabled by this file.
# Before activation: inspect repository/organization billing, included minutes,
# runner and artifact costs; obtain Founder approval. Review action versions.
name: Forma quality gates
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  quality:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      AI_MODE: demo
      FAL_KEY: ""
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '24'
          cache: npm
      - run: npm ci
      - run: npx playwright install --with-deps chromium
      - run: CHROMIUM_PATH="$(node -e 'console.log(require("playwright").chromium.executablePath())')" npm run quality
